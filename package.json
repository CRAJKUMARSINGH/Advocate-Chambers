{
  "name": "advocate-chambers",
  "private": true,
  "version": "1.0.0",
  "description": "Advocate-Chambers / Bar Association Banswara — hybrid React 19.3 + Python parametric CAD platform.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "uvicorn services.api.main:app --reload --port 8000",
    "build:web": "npm --prefix apps/web run build",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "draw:refined": "python bar-association-hall/generate_refined_cad.py",
    "draw:standard": "python bar-association-hall/generate_standard_drawings.py",
    "validate:standard": "python -c \"from bar_association_hall.drawing_model import load_model, validate_model; s,p=load_model(); e=validate_model(s,p); print('fail' if e else 'pass'); [print(x) for x in e]\"",
    "validate:week1": "python scripts/week1.py validate --write-report",
    "verify:week1": "python scripts/week1.py verify-manifest",
    "test:week1": "python -m unittest discover -s tests -p 'test_week1*.py'",
    "migrate:week2": "python scripts/week2.py migrate",
    "validate:week2": "python scripts/week2.py validate",
    "roundtrip:week2": "python scripts/week2.py roundtrip",
    "test:week2": "python -m unittest discover -s tests -p 'test_week2*.py'",
    "enrich:week34": "python scripts/week34.py report",
    "validate:week3": "python scripts/week3.py",
    "validate:week4": "python scripts/week4.py",
    "test:week34": "python -m unittest discover -s tests -p 'test_week34*.py'",
    "enrich:week56": "python scripts/week56.py report",
    "validate:week5": "python scripts/week5.py",
    "validate:week6": "python scripts/week6.py",
    "test:week56": "python -m unittest discover -s tests -p 'test_week56*.py'",
    "docs:patch-guide": "start code-junction/future-react-cad-transformation-patch-guide/deliverables/TRANSFORMATION_PATCH_GUIDE.md"
  },
  "devDependencies": {
    "markdown-pdf": "^11.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.0.0"
}
